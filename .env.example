# Copy to .env and change the password. Never commit .env.
POSTGRES_USER=kb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kb
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kb:change-me@localhost:5432/kb

# Hybrid search (BM25 + pgvector). Needs: pip install -e '.[vector]'
KB_VECTOR_ENABLED=false
# KB_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# KB_EMBEDDING_DIM=384

# Near-duplicate alert thresholds
# KB_DUPLICATE_LEXICAL_THRESHOLD=0.5
# KB_DUPLICATE_VECTOR_THRESHOLD=0.9

# Web UI (docker compose service "web")
# KB_SESSION_SECRET=<openssl rand -hex 32>   signs the login cookie
# KB_WEB_VECTOR_ENABLED=true                 hybrid search in the UI (downloads the model on first start)
